{
  "version": 1,
  "rules": [
    {
      "type": "forbidden",
      "id": "no-internal-state",
      "match": [".freebuff/**", "dist/**", "node_modules/**", "server/dist/**"],
      "reason": "Internal state and build output are not part of the reviewed repository.",
      "severity": "error"
    },
    {
      "type": "requireAdr",
      "id": "records-engine-governed",
      "match": ["src/records/**"],
      "adr": "0001",
      "reason": "Record persistence is governed by ADR-0001 (record storage engine).",
      "severity": "error"
    },
    {
      "type": "requireAdr",
      "id": "queues-governed",
      "match": ["src/queues/**"],
      "adr": "0002",
      "reason": "Background queues are governed by ADR-0002 (isolate background queues, still proposed).",
      "severity": "error"
    },
    {
      "type": "requireTest",
      "id": "src-needs-tests",
      "match": ["src/**/*.ts"],
      "testMatch": ["**/*.test.ts", "test/**"],
      "testExempt": ["**/*.d.ts"],
      "reason": "Every source change ships tests (docs/TESTING.md).",
      "severity": "error"
    },
    {
      "type": "requireDocUpdate",
      "id": "architecture-docs-stale",
      "match": ["src/records/**", "src/queues/**"],
      "docs": ["docs/ARCHITECTURE.md"],
      "reason": "Changes in ADR-governed areas should keep docs/ARCHITECTURE.md current.",
      "severity": "warning"
    },
    {
      "type": "layerDependency",
      "id": "layered-core",
      "layers": [
        { "name": "tools", "globs": ["server/src/tools/**", "server/src/*.ts"] },
        { "name": "engine", "globs": ["server/src/rules.ts", "server/src/scanner.ts", "server/src/secrets.ts", "server/src/impact.ts"] },
        { "name": "foundation", "globs": ["server/src/config.ts", "server/src/readers.ts", "server/src/types.ts"] }
      ],
      "direction": "inward-only",
      "reason": "Tools depend on engines; engines depend only on the foundation. No engine may import a tool, and the foundation imports nothing above it.",
      "severity": "error"
    }
  ]
}
