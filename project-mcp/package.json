{
  "name": "kritikka-mcp",
  "version": "0.1.3",
  "description": "Read-only MCP server serving project docs, ADRs, workflow, and rule-based change validation.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "repository-engineering",
    "architecture-rules",
    "adr",
    "governance",
    "context-engineering",
    "developer-tools",
    "typescript",
    "krittika"
  ],
  "type": "module",
  "license": "MIT",
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kritikka-mcp": "build/index.js"
  },
  "main": "build/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aayurt/kritikka-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run -s build && vitest run",
    "test:watch": "vitest",
    "version": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "picomatch": "^4.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}